# dependencies
node_modules/

# build output
dist/

# offline vendor cache (populated by scripts/fetch-vendor.ts, baked into --offline exports)
src/ui/vendor/

# vitepress
docs/.vitepress/dist/
docs/.vitepress/cache/

# logs
*.log

# editor / tooling local state
.claude/
.playwright-cli/
.vscode/
.idea/

# OS cruft
.DS_Store
Thumbs.db

# eval runs: the harness (evals.json, scripts/, README) and the benchmark
# scoreboard are source and stay tracked. The runs themselves are model samples —
# a rerun produces different text, so there is no useful diff, only churn. Commit
# an individual outputs/ deliberately when a run is worth keeping as a fixture.
_evals/**/outputs/
_evals/**/grading.json
_evals/**/timing.json

# scratch / throwaway
_ui-check.mjs
*.tmp
*.bun-build

# exported viewer HTML (scratch export)
*.html
# …except the demo export bundled into the docs site
!docs/public/**/*.html
!docs/public/*.html
